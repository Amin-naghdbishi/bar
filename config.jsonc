{
  "layer": "top",
  "position": "bottom",
  "height": 44,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,

  // Layout: Left: Workspace + App Icons -> Middle: Empty -> Right: Reversed System Tray
  "modules-left": [
    "niri/workspaces",
    "wlr/taskbar"
  ],

  "modules-center": [],

  "modules-right": [
    "pulseaudio#microphone",
    "pulseaudio",
    "memory",
    "disk",
    "niri/language",
    "network",
    "battery",
    "clock"
  ],

  // ---------------------------------------------------------------------------
  // Left Side: Current Workspace (Number Only)
  // ---------------------------------------------------------------------------
  "niri/workspaces": {
    "current-only": true,
    "format": "{index}",
    "tooltip": false
  },

  // ---------------------------------------------------------------------------
  // Left Side: Open Application Icons (Papirus Icon Theme, Cinnamon-style)
  // ---------------------------------------------------------------------------
  "wlr/taskbar": {
    "all-outputs": true,
    "format": "{icon}",
    "icon-theme": "Papirus-Dark",
    "icon-size": 22,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "sort-by-app-id": true
  },

  // ---------------------------------------------------------------------------
  // Right Side: System Information in REVERSED Right-to-Left Order:
  // Mic -> Volume -> RAM -> Disk -> Keyboard -> Wi-Fi -> Battery -> Clock
  // Each module displays BOTH its icon and value with comfortable 3-space gap
  // ---------------------------------------------------------------------------

  // 1. Microphone (Microphone icon and level/status)
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "   {volume}%",
    "format-source-muted": "   Muted",
    "tooltip-format": "Microphone: {volume}%\nDevice: {desc}",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%"
  },

  // 2. Audio Volume (Speaker icon and percentage)
  "pulseaudio": {
    "format": "{icon}   {volume}%",
    "format-muted": "   Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "tooltip-format": "Volume: {volume}%\nDevice: {desc}",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  // 3. RAM Usage (e.g. 6.2G)
  "memory": {
    "interval": 2,
    "format": "   {used:0.1f}G",
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
  },

  // 4. Free Disk Space (e.g. 124G)
  "disk": {
    "interval": 30,
    "path": "/",
    "format": "   {specific_free:0.0f}G",
    "unit": "GB",
    "tooltip-format": "Disk: {free} free ({percentage_free}%)"
  },

  // 5. Keyboard Layout (e.g. EN, DE)
  "niri/language": {
    "format": "   {}",
    "format-en": "EN",
    "format-us": "EN",
    "format-de": "DE",
    "format-fa": "FA",
    "format-ir": "FA",
    "format-fr": "FR",
    "format-es": "ES",
    "format-it": "IT",
    "format-ru": "RU",
    "format-tr": "TR",
    "format-uk": "UK",
    "format-ar": "AR",
    "format-pt": "PT",
    "format-nl": "NL",
    "format-pl": "PL"
  },

  // 6. Wi-Fi / Network
  "network": {
    "interval": 5,
    "format-wifi": "   {signalStrength}%",
    "format-ethernet": "󰈀   Eth",
    "format-disconnected": "󰤮   Off",
    "format-disabled": "󰤮   Off",
    "tooltip-format": "Wi-Fi: {essid} ({signalStrength}%)\nIP: {ipaddr}"
  },

  // 7. Battery (Icon and percentage)
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}   {capacity}%",
    "format-charging": "   {capacity}%",
    "format-plugged": "   {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "Battery: {capacity}%\n{timeTo}"
  },

  // 8. Clock (HH:MM)
  "clock": {
    "interval": 1,
    "format": "   {:%H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y}"
  }
}
